{
    "name": "ccai/integration-test-php",
    "description": "Integration tests for the CCAI PHP SDK",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "cloudcontactai/ccai-php": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": ".."
        }
    ],
    "autoload": {
        "psr-4": {
            "CCAITest\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
